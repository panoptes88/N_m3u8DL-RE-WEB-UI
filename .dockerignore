# Dockerignore

# Downloads - 个人下载数据
downloads/

# Database - 个人数据库
data.db

# Logs
*.log
Logs/
bin/Logs/

# Binaries - 二进制工具（需要自行准备）
bin/

# Node - 依赖与构建产物均在镜像内重新生成，无需进入构建上下文
node_modules/
**/node_modules
web/node_modules/
web/dist/
.npm-cache/
**/.npm-cache

# 沙箱内构建时使用的 Docker CLI 配置目录
.docker-config/

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Git
.git
.gitignore
